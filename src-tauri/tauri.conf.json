{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeCloud",
  "version": "0.2.2",
  "identifier": "ru.bytewizard.homecloud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HomeCloud",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "shadow": false,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}